# Public client configuration, never a Supabase service-role or secret key.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Optional server-only AI. Never use VITE_ for these.
# GROQ_API_KEY=your_private_groq_key
# GROQ_ALLOWED_USER_IDS=your_supabase_auth_user_uuid

# Server-only AES-256-GCM encryption key for account-saved Groq credentials.
# Generate ONCE: openssl rand -base64 32. Keep stable across deployments.
# Run supabase/assistant-credentials.sql before enabling.
# STEADY_CREDENTIAL_ENCRYPTION_KEY=your_32_random_bytes_as_base64
