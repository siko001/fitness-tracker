{
  "configVersion": "v3",
  "app": {
    "appName": "Steady", "appType": "app", "version": { "code": 1, "name": "0.1.0" },
    "icon": "icon.png", "vender": "Steady", "description": "Direct watch steps for your private Steady diary"
  },
  "permissions": ["data:user.hd.step", "device:os.bg_service"],
  "runtime": { "apiVersion": { "compatible": "3.0", "target": "3.0", "minVersion": "3.0" } },
  "targets": {
    "common": {
      "module": {
        "page": { "pages": ["page/index"] },
        "app-service": { "services": ["app-service/steps"] },
        "app-side": { "path": "app-side/index" },
        "setting": { "path": "setting/index" }
      },
      "platforms": [{ "st": "s" }],
      "designWidth": 390
    }
  },
  "defaultLanguage": "en-US"
}
